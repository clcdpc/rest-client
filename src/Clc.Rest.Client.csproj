<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Clc.Rest</RootNamespace>
    <Authors>Central Library Consortium, Michael Fields</Authors>
    <Description>simple http client library</Description>
    <PackageTags>clc, rest, http</PackageTags>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Version>3.0.0-beta.1</Version>
    <SignAssembly>False</SignAssembly>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>Clc.Rest.Client</PackageId>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageReleaseNotes>Beta 1: v3 targets .NET 8+ only, uses a single async ExecuteAsync&lt;T&gt;(RestRequest, CancellationToken) execution path, adds RestRequest factories, replaces context-dependent Parameters with QueryParameters and explicit Content/PostForm support, removes synchronous Execute&lt;T&gt;, removes sync-over-async response construction, removes the legacy response formatter path, requires content-aware async formatting, copies response headers and content headers, supports absolute URLs, chains request-hook return values, and hardens RestRequest defaults.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
  </ItemGroup>

</Project>
