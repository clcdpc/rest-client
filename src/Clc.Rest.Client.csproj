<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<RootNamespace>Clc.Rest</RootNamespace>
		<Authors>Central Library Consortium, Michael Fields</Authors>
		<Description>simple http client library</Description>
		<PackageTags>clc, rest, http</PackageTags>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
		<SignAssembly>False</SignAssembly>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageId>Clc.Rest.Client</PackageId>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<PackageReleaseNotes>Breaking beta: v3 now targets .NET 8+ only and the beta may continue to introduce breaking changes while the API is finalized, simplify execution to a single async ExecuteAsync&lt;T&gt;(RestRequest, CancellationToken) path, add RestRequest factories, replace context-dependent Parameters with QueryParameters and explicit Content/PostForm support, remove synchronous Execute&lt;T&gt;, remove sync-over-async response construction, remove legacy response formatter path, require content-aware async formatting, copy response headers/content headers, support absolute URLs, make request-building hooks mutate-only, harden RestRequest defaults, clarify default HttpClient lifetime with a shared process-lifetime internal client, keep injected HttpClient instances caller-owned, remove protected Client access, add protected SendAsync as the transport extension point, and make the authenticator API mutate only the supplied HttpRequestMessage and return void.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.*" />
	</ItemGroup>

</Project>
